# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control (it's in .gitignore)
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   flutter run --dart-define-from-file=.env
#
# DO NOT add `- .env` to the `assets:` list in pubspec.yaml. A Flutter asset
# declaration is not build-mode scoped, so the file would ship inside the
# release APK, the release IPA and the web build, where anyone can unzip it or
# fetch it at https://<host>/assets/.env. Use --dart-define-from-file (above)
# on native targets; `dart run tool/check_env_assets.dart` fails the build if
# an env file other than this one ends up in the asset list, or inside a
# directory the asset list declares (assets/config/, assets/images/).
#
# This file itself is an asset, which is why every value below is blank or a
# placeholder. Keep it that way.
#
# See docs/guides/configuration.md ("Never ship a secret in the bundle").
# ============================================================================

# ----------------------------------------------------------------------------
# Environment
# ----------------------------------------------------------------------------
# Options: development, staging, production
# A release build refuses to start as development. Build releases from a
# copy set to staging or production - .env.staging and .env.production are
# git-ignored for that: --dart-define-from-file=.env.production. That copy
# also needs API_SSL_FINGERPRINTS (below), or a release refuses to start.
ENVIRONMENT=development

# ----------------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------------
# Base URL for API requests. Empty in development means no backend: a debug
# build signs in with the offline demo account instead.
# Examples:
#   Development: http://localhost:3000
#     (Android emulator: http://10.0.2.2:3000 - localhost there is the
#     emulator itself; iOS Simulator, desktop and web use localhost)
#   Staging: https://api-staging.example.com
#   Production: https://api.example.com
BASE_URL=

# API Timeout Configuration (in seconds)
API_TIMEOUT=30
API_CONNECT_TIMEOUT=10
API_RECEIVE_TIMEOUT=30
API_SEND_TIMEOUT=30

# SSL/Certificate Pinning Configuration
# Comma-separated list of valid SHA-256 certificate fingerprints (without colons or with colons)
# Example: 12:34:56:...,78:90:ab:...
API_SSL_FINGERPRINTS=
# Force enable/disable SSL Pinning (Default: true in staging/prod; in dev, true
# once API_SSL_FINGERPRINTS is set, false otherwise)
# Enabling pinning with an empty API_SSL_FINGERPRINTS pins nothing: the app
# logs an error and asserts in debug builds, and a release build refuses to
# start. Set ENABLE_SSL_PINNING=false to ship a release without pinning.
ENABLE_SSL_PINNING=

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# Enable/disable features (true/false, 1/0, yes/no, on/off)
# If not set, defaults are environment-aware:
#   - Logging: enabled in development/staging
#   - Analytics: enabled in staging/production
#   - Crash Reporting: enabled in staging/production
#   - Performance Monitoring: enabled in staging/production
#   - Debug Features: enabled in development only

ENABLE_LOGGING=
ENABLE_ANALYTICS=
ENABLE_CRASH_REPORTING=
ENABLE_PERFORMANCE_MONITORING=
ENABLE_DEBUG_FEATURES=
ENABLE_HTTP_LOGGING=

# ----------------------------------------------------------------------------
# Additional Configuration
# ----------------------------------------------------------------------------
# Add your own NON-SECRET configuration here, and add the key to
# lib/core/config/dart_defines.dart so it also works via --dart-define.
#
# WARNING - what must never go in a .env used by this app:
#   API keys, client secrets, access tokens, signing material, database URLs.
# Everything in a shipped build is readable by its user. On native, a
# dart-define is compiled into the binary and recoverable from it; on web the
# whole bundle is downloaded, so a web client cannot hold a secret at all.
# Anything privileged belongs on a server the app authenticates to, which
# proxies the call or issues a short-lived, scoped token.
#
# Example of a value that is safe here (public by design, per-environment):
# SUPPORT_URL=https://support.example.com
#
# A Sentry DSN is a judgement call: it is designed to be embedded in clients,
# but it is still a public write endpoint for your project. If you add one,
# add it knowing it is public.
