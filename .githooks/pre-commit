#!/usr/bin/env bash
# Runs before each commit. Keeps scope aligned with CI (see .github/workflows/ci.yml).
set -euo pipefail

echo "Running pre-commit checks..."

if ! command -v flutter >/dev/null 2>&1; then
  echo "⚠️  Flutter not found. Skipping pre-commit checks."
  exit 0
fi

# Git exports its own environment into every hook process. In a plain clone
# that is harmless - a probe of a plain clone shows only
# GIT_INDEX_FILE (relative), GIT_PREFIX, GIT_EXEC_PATH and the author fields.
# In a worktree, and under `git --git-dir=...`, git also exports an absolute
# GIT_DIR, and that one is poison here: `flutter` shells out to git to work out
# which SDK it is, and an inherited GIT_DIR makes that lookup read THIS
# repository instead of the SDK. The SDK then reports a version derived from
# this project's tags - or, in the reporter's worktree, `0.0.0-unknown`, which
# fails the `environment: sdk:` constraint in pubspec.yaml and rejects the
# commit while `flutter analyze` run by hand in the same tree is clean.
#
# So run every Flutter and Dart command with the git variables removed. Only
# the hook's own git call (the export below) keeps them: it needs
# GIT_INDEX_FILE, which names the index this commit is made from. This
# resolves the SDK rather than detecting the breakage and explaining it: there
# is no reason to teach the hook a good error message for a state it can
# simply not be in.
no_git_env=(
  env
  -u GIT_DIR
  -u GIT_WORK_TREE
  -u GIT_INDEX_FILE
  -u GIT_COMMON_DIR
  -u GIT_OBJECT_DIRECTORY
  -u GIT_ALTERNATE_OBJECT_DIRECTORIES
  -u GIT_PREFIX
)

# Without resolved dependencies `dart format` cannot read the
# very_good_analysis include in analysis_options.yaml, formats with the wrong
# settings, and rewrites ~100 untouched files in place before failing.
# Refuse before anything runs.
if [ ! -f .dart_tool/package_config.json ]; then
  echo "❌ Dependencies are not resolved (.dart_tool/package_config.json is missing)."
  echo "   Run: flutter pub get"
  echo "   Nothing was formatted or changed."
  exit 1
fi

# Check what is being committed, not the working copy: export the index to a
# temporary tree and run there. Checking the working copy let a staged file
# that was fixed but not restaged through, and let an unstaged broken file
# block a clean commit. GIT_INDEX_FILE is inherited on purpose: for
# `git commit <path>` and `git commit -a`, git builds a temporary index, and
# that is the content the commit will hold. The working copy is never written.
# The export sits beside the repository - same parent, same depth - so every
# relative path resolves from it exactly as from the checkout: a monorepo's
# `path: ../shared` in pubspec.yaml, and the rootUris pub wrote relative to
# .dart_tool/. In the system temp directory those named nothing, and every
# commit with such a dependency failed. A parent that cannot be written to
# falls back to the temp directory.
repo="$(pwd)"
staged="$(mktemp -d "$(dirname "$repo")/.$(basename "$repo")-pre-commit.XXXXXX" 2>/dev/null)" ||
  staged="$(mktemp -d)"
trap 'rm -rf "$staged"' EXIT
git checkout-index --all --prefix="$staged/"
mkdir -p "$staged/.dart_tool"
cp -p .dart_tool/package_config.json "$staged/.dart_tool/"
if [ -f .dart_tool/package_graph.json ]; then
  cp -p .dart_tool/package_graph.json "$staged/.dart_tool/"
fi
cd "$staged"

echo "📝 Checking code formatting (staged content)..."
if ! "${no_git_env[@]}" dart format --output=none --set-exit-if-changed lib test integration_test tool examples; then
  echo "❌ Code formatting check failed for the staged content."
  echo "   Fix: ./scripts/dev/format_dart.sh, then stage the result"
  echo "   Or: dart format lib test integration_test tool examples"
  exit 1
fi

echo "🔍 Running flutter analyze (staged content)..."
if ! "${no_git_env[@]}" flutter analyze; then
  echo "❌ flutter analyze failed for the staged content."
  exit 1
fi

echo "✅ Pre-commit checks passed."
