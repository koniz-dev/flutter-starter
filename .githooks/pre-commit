#!/usr/bin/env bash
# Runs before each commit. Keeps scope aligned with CI (see .github/workflows/ci.yml).
set -euo pipefail

echo "Running pre-commit checks..."

if ! command -v flutter >/dev/null 2>&1; then
  echo "⚠️  Flutter not found. Skipping pre-commit checks."
  exit 0
fi

# Git exports its own environment into every hook process. In a plain clone
# that is harmless - a probe of a plain clone shows only
# GIT_INDEX_FILE (relative), GIT_PREFIX, GIT_EXEC_PATH and the author fields.
# In a worktree, and under `git --git-dir=...`, git also exports an absolute
# GIT_DIR, and that one is poison here: `flutter` shells out to git to work out
# which SDK it is, and an inherited GIT_DIR makes that lookup read THIS
# repository instead of the SDK. The SDK then reports a version derived from
# this project's tags - or, in the reporter's worktree, `0.0.0-unknown`, which
# fails the `environment: sdk:` constraint in pubspec.yaml and rejects the
# commit while `flutter analyze` run by hand in the same tree is clean.
#
# So run every Flutter and Dart command with the git variables removed. Only
# the hook's own git call (the export below) keeps them: it needs
# GIT_INDEX_FILE, which names the index this commit is made from. This
# resolves the SDK rather than detecting the breakage and explaining it: there
# is no reason to teach the hook a good error message for a state it can
# simply not be in.
no_git_env=(
  env
  -u GIT_DIR
  -u GIT_WORK_TREE
  -u GIT_INDEX_FILE
  -u GIT_COMMON_DIR
  -u GIT_OBJECT_DIRECTORY
  -u GIT_ALTERNATE_OBJECT_DIRECTORIES
  -u GIT_PREFIX
)

# git runs a hook from the top of the working tree. With the app in a
# subdirectory of a larger repository (a monorepo), that is not the app: the
# checks below run in the app, found from this file's own path
# (<app>/.githooks/pre-commit). Not `git rev-parse --show-prefix`: in a linked
# worktree git exports GIT_DIR, and git then takes the current directory for
# the top, so the prefix always read as empty. The physical paths (`pwd -P`)
# keep a symlinked checkout from looking like a subdirectory.
top="$(pwd -P)"
app="$(cd "$(dirname "$0")/.." && pwd -P)"
# A copy run from outside the working tree (a shared hooks directory) checks
# the top, as it always has.
case "$app" in
  "$top"/*) app_prefix="${app#"$top"/}/" ;;
  *) app="$top" app_prefix="" ;;
esac
cd "$app"

# Where pub wrote the resolved package config. Normally the app's own
# .dart_tool/. In a pub workspace (a root pubspec.yaml listing the app under
# `workspace:`, the app declaring `resolution: workspace`), pub writes it only
# at the workspace root, and the app gets .dart_tool/pub/workspace_ref.json,
# whose workspaceRoot is relative to that file's directory.
config_dir="$app"
workspace_ref=".dart_tool/pub/workspace_ref.json"
if [ ! -f .dart_tool/package_config.json ] && [ -f "$workspace_ref" ]; then
  root_rel="$(sed -n 's/.*"workspaceRoot"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$workspace_ref" | head -n 1)"
  if [ -n "$root_rel" ] && root_dir="$(cd ".dart_tool/pub/$root_rel" 2>/dev/null && pwd -P)"; then
    config_dir="$root_dir"
  fi
fi

# Without resolved dependencies `dart format` cannot read the
# very_good_analysis include in analysis_options.yaml, formats with the wrong
# settings, and rewrites ~100 untouched files in place before failing.
# Refuse before anything runs. In a workspace, `flutter pub get` in the app
# resolves the whole workspace.
if [ ! -f "$config_dir/.dart_tool/package_config.json" ]; then
  echo "❌ Dependencies are not resolved (.dart_tool/package_config.json is missing)."
  echo "   Run: flutter pub get"
  echo "   Nothing was formatted or changed."
  exit 1
fi

# The export below holds the git working tree, so the config has to sit
# inside it to be copied to the same place.
case "$config_dir" in
  "$top") config_prefix="" ;;
  "$top"/*) config_prefix="${config_dir#"$top"/}/" ;;
  *)
    echo "❌ The pub workspace root ($config_dir) is outside this git repository,"
    echo "   so the staged content cannot be checked against its dependencies."
    echo "   Commit from a repository that contains the workspace root."
    exit 1
    ;;
esac

# Check what is being committed, not the working copy: export the index to a
# temporary tree and run there. Checking the working copy let a staged file
# that was fixed but not restaged through, and let an unstaged broken file
# block a clean commit. GIT_INDEX_FILE is inherited on purpose: for
# `git commit <path>` and `git commit -a`, git builds a temporary index, and
# that is the content the commit will hold. The working copy is never written.
# The export sits beside the repository - same parent, same depth - so every
# relative path resolves from it exactly as from the checkout: a monorepo's
# `path: ../shared` in pubspec.yaml, and the rootUris pub wrote relative to
# .dart_tool/. In the system temp directory those named nothing, and every
# commit with such a dependency failed. A parent that cannot be written to
# falls back to the temp directory.
# The whole working tree is exported, so the app sits at the same depth in the
# export as in the checkout.
repo="$top"
parent="$(dirname "$repo")"
prefix=".$(basename "$repo")-pre-commit."
# An export an earlier run could not remove (the hook was killed) is swept
# once it is an hour old; a younger one may belong to a commit in progress.
find "$parent" -maxdepth 1 -type d -name "$prefix*" -mmin +60 \
  -exec rm -rf {} + 2>/dev/null || true
if ! staged="$(mktemp -d "$parent/${prefix}XXXXXX" 2>/dev/null)"; then
  staged="$(mktemp -d)"
  echo "⚠️  Cannot write beside the repository; checking in $staged instead."
  echo "   A relative path: dependency outside the repository will not resolve there."
fi
trap 'rm -rf "$staged"' EXIT
(cd "$top" && git checkout-index --all --prefix="$staged/")
mkdir -p "$staged/$config_prefix.dart_tool"
cp -p "$config_dir/.dart_tool/package_config.json" "$staged/$config_prefix.dart_tool/"
if [ -f "$config_dir/.dart_tool/package_graph.json" ]; then
  cp -p "$config_dir/.dart_tool/package_graph.json" "$staged/$config_prefix.dart_tool/"
fi
if [ "$config_dir" != "$app" ]; then
  mkdir -p "$staged/$app_prefix.dart_tool/pub"
  cp -p "$workspace_ref" "$staged/$app_prefix.dart_tool/pub/"
fi
cd "$staged/$app_prefix"

echo "📝 Checking code formatting (staged content)..."
if ! "${no_git_env[@]}" dart format --output=none --set-exit-if-changed lib test integration_test tool examples; then
  echo "❌ Code formatting check failed for the staged content."
  echo "   Fix: ./scripts/dev/format_dart.sh, then stage the result"
  echo "   Or: dart format lib test integration_test tool examples"
  exit 1
fi

echo "🔍 Running flutter analyze (staged content)..."
if ! "${no_git_env[@]}" flutter analyze; then
  echo "❌ flutter analyze failed for the staged content."
  exit 1
fi

echo "✅ Pre-commit checks passed."
