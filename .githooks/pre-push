#!/usr/bin/env bash
# Tests the working tree, not the pushed commit tips, for branch updates.
# Pushes containing only remote tags or deletions skip the suite.
# A manual invocation without stdin refs still tests the working tree.
set -euo pipefail

saw_ref=false
has_branch_update=false
if [[ ! -t 0 ]]; then
  while read -r _pushed_local_ref pushed_local_oid pushed_remote_ref _pushed_remote_oid; do
    saw_ref=true
    case "$pushed_remote_ref" in
      refs/tags/*) ;;
      *)
        if [[ ! "$pushed_local_oid" =~ ^0+$ ]]; then
          has_branch_update=true
        fi
        ;;
    esac
  done
fi
if $saw_ref && ! $has_branch_update; then
  echo "Skipping tests: push contains only tags or deletions."
  exit 0
fi

echo "Running pre-push checks..."

if ! command -v flutter >/dev/null 2>&1; then
  echo "⚠️  Flutter not found. Skipping tests."
  exit 0
fi

# Git exports its own environment into every hook process. In a plain clone
# that is harmless - a probe of a plain clone shows only
# GIT_INDEX_FILE (relative), GIT_PREFIX, GIT_EXEC_PATH and the author fields.
# In a worktree, and under `git --git-dir=...`, git also exports an absolute
# GIT_DIR, and that one is poison here: `flutter` shells out to git to work out
# which SDK it is, and an inherited GIT_DIR makes that lookup read THIS
# repository instead of the SDK. The SDK then reports a version derived from
# this project's tags - or, in the reporter's worktree, `0.0.0-unknown`, which
# fails the `environment: sdk:` constraint in pubspec.yaml and rejects the push
# while `flutter test` run by hand in the same tree is green. The pre-commit
# hook is where it was first observed; this hook runs the
# same class of command from the same kind of process, so it gets the same
# treatment rather than waiting to be reported separately.
#
# So run every Flutter and Dart command with the git variables removed. The
# hook itself never calls git, so nothing else needs them. This resolves the
# SDK rather than detecting the breakage and explaining it: there is no reason
# to teach the hook a good error message for a state it can simply not be in.
no_git_env=(
  env
  -u GIT_DIR
  -u GIT_WORK_TREE
  -u GIT_INDEX_FILE
  -u GIT_COMMON_DIR
  -u GIT_OBJECT_DIRECTORY
  -u GIT_ALTERNATE_OBJECT_DIRECTORIES
  -u GIT_PREFIX
)

# git runs a hook from the top of the working tree. With the app in a
# subdirectory of a larger repository (a monorepo), that is not the app, and
# `flutter test` found no test/ there. This file is <app>/.githooks/pre-push;
# a copy run from outside the working tree (a shared hooks directory) tests
# the top, as it always has.
top="$(pwd -P)"
app="$(cd "$(dirname "$0")/.." && pwd -P)"
case "$app" in
  "$top"/*) cd "$app" ;;
esac

echo "🧱 Running flutter test (compact reporter, 15m timeout)..."
if ! "${no_git_env[@]}" flutter test --reporter compact --timeout 15m; then
  echo "❌ flutter test failed."
  exit 1
fi

echo "✅ Pre-push checks passed."
