diff --git a/l10n.yaml b/l10n.yaml
index 8d0e1f4b3a2..b0a46070728 100644
--- a/l10n.yaml
+++ b/l10n.yaml
@@ -3,3 +3,14 @@ template-arb-file: app_en.arb
 output-localization-file: app_localizations.dart
 output-class: AppLocalizations
 
+# The SDK generator still references legacy Global* classes. Explicit prefixes
+# bind those names to standalone delegate adapters without editing its output.
+# Relative imports preserve package renaming by the setup brick.
+# Every locale file receives this header; the prefixes are used by the base
+# file only, so the generated subclasses need the unused-import annotations.
+header: |
+  // Bind the SDK generator's Global* names to standalone design-library delegates.
+  // ignore: unused_import
+  import '../core/localization/cupertino_localizations_delegate.dart' as GlobalCupertinoLocalizations;
+  // ignore: unused_import
+  import '../core/localization/material_localizations_delegate.dart' as GlobalMaterialLocalizations;
diff --git a/lib/core/localization/cupertino_localizations_delegate.dart b/lib/core/localization/cupertino_localizations_delegate.dart
new file mode 100644
index 00000000000..c40da0360a3
--- /dev/null
+++ b/lib/core/localization/cupertino_localizations_delegate.dart
@@ -0,0 +1,9 @@
+import 'package:cupertino_ui/cupertino_ui.dart' as ui;
+
+/// Standalone Cupertino delegate for SDK-generated localization code.
+///
+/// The `l10n.yaml` header binds its generated `GlobalCupertinoLocalizations`
+/// reference to this library prefix instead of the legacy SDK class. Keep this
+/// adapter until the generator itself emits standalone design-library imports.
+const ui.LocalizationsDelegate<ui.CupertinoLocalizations> delegate =
+    ui.GlobalCupertinoLocalizations.delegate;
