--- a/bricks/flutter_starter_setup/hooks/pre_gen.dart
+++ b/bricks/flutter_starter_setup/hooks/pre_gen.dart
@@ -15,11 +15,73 @@ void run(HookContext context) {
     iosBundleIdProblem(context.vars['ios_bundle_id'] as String),
     displayNameProblem(context.vars['app_display_name'] as String),
