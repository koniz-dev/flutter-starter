##[group]Run set -euo pipefail
set -euo pipefail
APK=$(ls build/app/outputs/flutter-apk/*.apk | head -1)
echo "APK: $APK"

APKSIGNER=$(ls -1 "${ANDROID_HOME:-$ANDROID_SDK_ROOT}"/build-tools/*/apksigner 2>/dev/null | sort -V | tail -1)
if [ -z "$APKSIGNER" ]; then
  echo "::error::apksigner not found under ANDROID_HOME; cannot verify the signer."
  exit 1
fi
echo "Using: $APKSIGNER"

"$APKSIGNER" verify --print-certs --verbose "$APK" | tee /tmp/apk-certs.txt

if ! grep -q 'Signer #1 certificate DN:' /tmp/apk-certs.txt; then
  echo "::error::apksigner printed no certificate DN."
  exit 1
fi
if grep -q 'CN=Android Debug' /tmp/apk-certs.txt; then
  echo "::error::APK is DEBUG-signed. android/app/build.gradle.kts is supposed to make this impossible."
  exit 1
fi
