=== step: Build the probe APK ===

##[group]Run set -euo pipefail
set -euo pipefail
case "development" in
  development)
    echo "PROBE: debug-signed APK (expect the guard to FAIL on CN=Android Debug)"
    flutter build apk --debug \
      --dart-define=ENVIRONMENT=development \
      --dart-define=BASE_URL=http://localhost:3000
    ;;
  staging)
    echo "PROBE: unsigned APK (expect the guard to FAIL: no readable certificate)"
    flutter build apk --release \
      --dart-define=ENVIRONMENT=staging \
      --dart-define=BASE_URL=http://localhost:3000
    ;;
  *)
    echo "::error::probe branch supports environment=development or staging only"
    exit 1
    ;;
esac
