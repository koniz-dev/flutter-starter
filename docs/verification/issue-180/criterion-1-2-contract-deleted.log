    25	/// Notified when a session ends without the user asking for it.
    26	///
    27	/// The transport is where an expired session is *discovered*: `AuthInterceptor`
    28	/// sees the 401, fails the refresh, and clears the persisted session. Nothing
    29	/// there may reach into the feature holding the in-memory session, so the
    30	/// feature implements this and hands it down - the same inversion
    31	/// `IHttpResponseCache` uses in the opposite direction.
    32	///
    33	/// Implementations must be **best effort and non-throwing on their own terms**:
    34	/// this is called from a `finally`-adjacent cleanup path whose only real job is
    35	/// to complete the failing request's handler.
    36	abstract class ISessionTerminationSink {
    37	  /// Drops any in-memory session state.
    38	  ///
    39	  /// Persisted teardown (tokens, cached user, cached responses) has already
    40	  /// run by the time this is called, so an implementation must not repeat it -
    41	  /// and in particular must not call a logout endpoint, which would post with
    42	  /// credentials that no longer exist.
    43	  void onSessionTerminated();
    44	}

