======== STEP: Enforce coverage thresholds ========
##[group]Run OVERALL=89.9
^[[36;1mOVERALL=89.9^[[0m
^[[36;1mDOMAIN_COV=100.0^[[0m
^[[36;1mDATA_COV=96.0^[[0m
^[[36;1mPRESENTATION_COV=95.4^[[0m
^[[36;1mCORE_COV=85.1^[[0m
^[[36;1m^[[0m
^[[36;1mFAILED=0^[[0m
^[[36;1m^[[0m
^[[36;1mcheck_threshold() {^[[0m
^[[36;1m  local name=$1^[[0m
^[[36;1m  local current=$2^[[0m
^[[36;1m  local target=$3^[[0m
^[[36;1m  if (( $(echo "$current < $target" | bc -l) )); then^[[0m
^[[36;1m    echo "❌ $name: ${current}% < ${target}%"^[[0m
^[[36;1m    return 1^[[0m
^[[36;1m  else^[[0m
^[[36;1m    echo "✅ $name: ${current}% >= ${target}%"^[[0m
^[[36;1m    return 0^[[0m
^[[36;1m  fi^[[0m
^[[36;1m}^[[0m
^[[36;1m^[[0m
^[[36;1mcheck_threshold "Total Coverage" "$OVERALL" 80 || exit 1^[[0m
^[[36;1mcheck_threshold "Domain Layer" "$DOMAIN_COV" 100 || FAILED=1^[[0m
^[[36;1mcheck_threshold "Data Layer" "$DATA_COV" 90 || FAILED=1^[[0m
^[[36;1mcheck_threshold "Presentation Layer" "$PRESENTATION_COV" 80 || FAILED=1^[[0m
^[[36;1mcheck_threshold "Core Layer" "$CORE_COV" 80 || FAILED=1^[[0m
^[[36;1m^[[0m
^[[36;1mif [ $FAILED -eq 1 ]; then^[[0m
^[[36;1m  echo "⚠️ One or more architectural layers did not meet coverage targets."^[[0m
^[[36;1m  exit 1^[[0m
^[[36;1mfi^[[0m
