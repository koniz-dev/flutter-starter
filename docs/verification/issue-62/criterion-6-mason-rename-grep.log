# --- Patrol harness parity in the generated project ---
#
#   $ find android/app/src/androidTest android/app/src/main/kotlin -type f
#   android/app/src/main/kotlin/com/acme/mobile/MainActivity.kt
#   android/app/src/androidTest/java/com/acme/mobile/MainActivityTest.java
#
#   $ head -1 android/app/src/androidTest/java/com/acme/mobile/MainActivityTest.java
#   package com.acme.mobile;
#   $ head -1 android/app/src/main/kotlin/com/acme/mobile/MainActivity.kt
#   package com.acme.mobile
#
#   $ grep -n 'namespace =\|applicationId =' android/app/build.gradle.kts
#   51:    namespace = "com.acme.mobile"
#   66:        applicationId = "com.acme.mobile"
#
#   $ sed -n '/^patrol:/,/package_name/p' pubspec.yaml
#   patrol:
#     app_name: Acme App
#     android:
#       package_name: com.acme.mobile
#
#   $ grep -n 'android:label' android/app/src/main/AndroidManifest.xml
#   15:        android:label="Acme App"
#
# MainActivityTest and MainActivity are in the same package; that package is both
# the applicationId and the Kotlin namespace; patrol's package_name matches it.
# That is the static precondition for the androidTest variant to compile
# (MainActivityTest references MainActivity.class with no import) and for
# `patrol test` to instrument the app it just installed.
#
# NOT verified here: an actual javac / Gradle compile of the renamed androidTest
# variant. That needs a JDK and an Android SDK; on this machine
# `java -version` reports "Unable to locate a Java Runtime" and there is no
# Android SDK. Routed to status:needs-uat.
