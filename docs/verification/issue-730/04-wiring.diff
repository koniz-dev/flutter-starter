@@ -0,0 +1,31 @@
+import 'package:acme_notes/features/auth/domain/entities/user.dart';
+import 'package:acme_notes/features/auth/presentation/providers/auth_provider.dart';
+import 'package:acme_notes/features/notes/presentation/screens/notes_screen.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../../helpers/pump_app.dart';
+
+class _SignedIn extends AuthNotifier {
+  @override
+  AuthState build() => const AuthState(
+    user: User(id: 'u-1', email: 'a@b.co'),
+  );
+}
+
+void main() {
+  testWidgets('a signed-in user reaches the notes screen from home', (
+    tester,
+  ) async {
+    await pumpAppRouter(
+      tester,
+      overrides: [
+        authNotifierProvider.overrideWith(_SignedIn.new),
+        sessionRestorationProvider.overrideWith((ref) async {}),
+      ],
+    );
+    await tester.tap(find.widgetWithText(FilledButton, 'Notes'));
+    await tester.pumpAndSettle();
+    expect(find.byType(NotesScreen), findsOneWidget);
+  });
+}
