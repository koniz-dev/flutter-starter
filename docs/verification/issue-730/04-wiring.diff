diff --git a/lib/features/notes/routing/notes_routes.dart b/lib/features/notes/routing/notes_routes.dart
new file mode 100644
index 0000000..629bdba
--- /dev/null
+++ b/lib/features/notes/routing/notes_routes.dart
@@ -0,0 +1,14 @@
+import 'package:acme_notes/core/routing/app_routes.dart';
+import 'package:acme_notes/features/notes/presentation/screens/notes_screen.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:go_router/go_router.dart';
+
+/// Builds the Notes route, reachable once signed in.
+GoRoute buildNotesRoute(Ref ref) {
+  return GoRoute(
+    path: AppRoutes.notes,
+    name: AppRoutes.notesName,
+    builder: (context, state) =>
+        NotesScreen(id: state.uri.queryParameters['id'] ?? '1'),
+  );
+}
