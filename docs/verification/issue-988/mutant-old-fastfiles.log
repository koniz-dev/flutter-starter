              '\n'
              '    version_name = version_match[1]\n'
              '    version_code = version_match[2]\n'
              '    UI.message("Version: #{version_name}, Version Code: #{version_code}")\n'
              '    # NOT `return`: a lane body is a block, and `return` inside one raises\n'
              '    # LocalJumpError, which fastlane reports as an error in the lane that\n'
              '    # *called* this one. The last expression is the lane\'s return value.\n'
              '    { version: version_name, version_code: version_code }\n'
              '  end\n'
              '\n'
              '  # ========================================================================\n'
              '  # Build Lanes\n'
              '  # ========================================================================\n'
              '\n'
              '  desc "Build App Bundle for Play Store"\n'
              '  lane :build_bundle do |options|\n'
              '    environment = options[:environment] || "production"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_PRODUCTION"] || "https://api.example.com"\n'
              '\n'
              '    UI.message("Building App Bundle - Environment: #{environment}")\n'
              '\n'
              '    # The bundled-secrets guard, before any build: a `.env` declared as a\n'
              '    # Flutter asset ships inside the artifact. `sh` raises on a non-zero exit,\n'
              '    # so a failing guard aborts the lane.\n'
              '    sh("cd .. && dart run tool/check_env_assets.dart")\n'
              '\n'
              '    # Get version info\n'
              '    version_info = get_version\n'
              '\n'
              '    # Build App Bundle using Flutter. Values are shell-escaped: they come from\n'
              '    # lane options and CI secrets, both of which can contain shell metacharacters.\n'
              '    sh("cd .. && flutter build appbundle " \\\n'
              '       "--release " \\\n'
              '       "--dart-define=ENVIRONMENT=#{Shellwords.escape(environment)} " \\\n'
              '       "--dart-define=BASE_URL=#{Shellwords.escape(base_url)}")\n'
              '\n'
              '    # App Bundle path (flavorless layout).\n'
              '    # Absolute: lane code runs in fastlane/, but fastlane runs every action\n'
              '    # from the project root, so a relative path that File.exist? accepts\n'
              '    # here names a file outside the repository by the time the upload\n'
              '    # action reads it, and the upload fails with "Could not find ... file".\n'
              '    bundle_path = File.expand_path("../build/app/outputs/bundle/release/app-release.aab")\n'
              '\n'
              '    UI.user_error!("App Bundle not found at #{bundle_path}") unless File.exist?(bundle_path)\n'
              '\n'
              '    UI.success("App Bundle built successfully: #{bundle_path}")\n'
              '    bundle_path\n'
              '  end\n'
              '\n'
              '  desc "Build APK for testing"\n'
              '  lane :build_apk do |options|\n'
              '    environment = options[:environment] || "production"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_PRODUCTION"] || "https://api.example.com"\n'
              '\n'
              '    UI.message("Building APK - Environment: #{environment}")\n'
              '\n'
              '    # The bundled-secrets guard, before any build: a `.env` declared as a\n'
              '    # Flutter asset ships inside the artifact. `sh` raises on a non-zero exit,\n'
              '    # so a failing guard aborts the lane.\n'
              '    sh("cd .. && dart run tool/check_env_assets.dart")\n'
              '\n'
              '    # Build APK using Flutter\n'
              '    sh("cd .. && flutter build apk " \\\n'
              '       "--release " \\\n'
              '       "--dart-define=ENVIRONMENT=#{Shellwords.escape(environment)} " \\\n'
              '       "--dart-define=BASE_URL=#{Shellwords.escape(base_url)}")\n'
              '\n'
              '    # APK path (flavorless layout)\n'
              '    # Absolute, as bundle_path in build_bundle: actions run from the project\n'
              '    # root, not from fastlane/.\n'
              '    apk_path = File.expand_path("../build/app/outputs/flutter-apk/app-release.apk")\n'
              '\n'
              '    UI.user_error!("APK not found at #{apk_path}") unless File.exist?(apk_path)\n'
              '\n'
              '    UI.success("APK built successfully: #{apk_path}")\n'
              '    apk_path\n'
              '  end\n'
              '\n'
              '  # ========================================================================\n'
              '  # Deployment Lanes\n'
              '  # ========================================================================\n'
              '\n'
              '  desc "Upload to Google Play Store (Internal track)"\n'
              '  lane :upload_internal do |options|\n'
              '    environment = options[:environment] || "staging"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_STAGING"] || "https://api-staging.example.com"\n'
              '    track = options[:track] || "internal"\n'
              '\n'
              '    # Build App Bundle\n'
