              '\n'
              '    # Build and upload to alpha\n'
              '    bundle_path = build_bundle(environment: environment, base_url: base_url)\n'
              '\n'
              '    upload_to_play_store(\n'
              '      aab: bundle_path,\n'
              '      track: "alpha",\n'
              '      package_name: PACKAGE_NAME,\n'
              '      skip_upload_apk: true,\n'
              '      skip_upload_aab: false,\n'
              '      skip_upload_metadata: true,\n'
              '      skip_upload_images: true,\n'
              '      skip_upload_screenshots: true\n'
              '    )\n'
              '\n'
              '    UI.success("Successfully uploaded to Google Play Store (alpha track)!")\n'
              '  end\n'
              '\n'
              '  desc "Upload to Google Play Store (Beta track)"\n'
              '  lane :upload_beta do |options|\n'
              '    environment = options[:environment] || "staging"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_STAGING"] || "https://api-staging.example.com"\n'
              '\n'
              '    # Build and upload to beta\n'
              '    bundle_path = build_bundle(environment: environment, base_url: base_url)\n'
              '\n'
              '    upload_to_play_store(\n'
              '      aab: bundle_path,\n'
              '      track: "beta",\n'
              '      package_name: PACKAGE_NAME,\n'
              '      skip_upload_apk: true,\n'
              '      skip_upload_aab: false,\n'
              '      skip_upload_metadata: true,\n'
              '      skip_upload_images: true,\n'
              '      skip_upload_screenshots: true\n'
              '    )\n'
              '\n'
              '    UI.success("Successfully uploaded to Google Play Store (beta track)!")\n'
              '  end\n'
              '\n'
              '  desc "Upload to Google Play Store (Production track)"\n'
              '  lane :upload_production do |options|\n'
              '    environment = options[:environment] || "production"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_PRODUCTION"] || "https://api.example.com"\n'
              '\n'
              '    # Build and upload to production\n'
              '    bundle_path = build_bundle(environment: environment, base_url: base_url)\n'
              '\n'
              '    upload_to_play_store(\n'
              '      aab: bundle_path,\n'
              '      track: "production",\n'
              '      package_name: PACKAGE_NAME,\n'
              '      skip_upload_apk: true,\n'
              '      skip_upload_aab: false,\n'
              '      skip_upload_metadata: true,\n'
              '      skip_upload_images: true,\n'
              '      skip_upload_screenshots: true,\n'
              '      release_status: "completed" # or "draft" for manual release\n'
              '    )\n'
              '\n'
              '    UI.success("Successfully uploaded to Google Play Store (production track)!")\n'
              '  end\n'
              '\n'
              '  desc "Upload to Google Play Store with automatic track selection"\n'
              '  lane :upload do |options|\n'
              '    environment = options[:environment] || "production"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_PRODUCTION"] || "https://api.example.com"\n'
              '    track = options[:track] || (environment == "production" ? "production" : "internal")\n'
              '\n'
              '    # Build App Bundle\n'
              '    bundle_path = build_bundle(environment: environment, base_url: base_url)\n'
              '\n'
              '    # Upload to Google Play Store\n'
              '    upload_to_play_store(\n'
              '      aab: bundle_path,\n'
              '      track: track,\n'
              '      package_name: PACKAGE_NAME,\n'
              '      skip_upload_apk: true,\n'
              '      skip_upload_aab: false,\n'
              '      skip_upload_metadata: true,\n'
              '      skip_upload_images: true,\n'
              '      skip_upload_screenshots: true,\n'
              '      whatsnew_directory: "fastlane/metadata/android/en-US/changelogs"\n'
              '    )\n'
              '\n'
              '    UI.success("Successfully uploaded to Google Play Store (#{track} track)!")\n'
              '  end\n'
              '\n'
              '  # ========================================================================\n'
              '  # Utility Lanes\n'
              '  # ========================================================================\n'
              '\n'
              '  desc "Increment build number"\n'
              '  lane :increment_build do\n'
              '    # This would require a script to update pubspec.yaml\n'
