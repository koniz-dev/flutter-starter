              '\n'
              '    # Upload to Google Play Store\n'
              '    upload_to_play_store(\n'
              '      aab: bundle_path,\n'
              '      track: track,\n'
              '      package_name: PACKAGE_NAME,\n'
              '      skip_upload_apk: true,\n'
              '      skip_upload_aab: false,\n'
              '      skip_upload_metadata: true,\n'
              '      skip_upload_images: true,\n'
              '      skip_upload_screenshots: true,\n'
              '      # Credentials, if not set in the Appfile (json_key_file / json_key_data_raw)\n'
              '      # or through SUPPLY_JSON_KEY / SUPPLY_JSON_KEY_DATA:\n'
