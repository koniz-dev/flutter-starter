              '  # ========================================================================\n'
              '\n'
              '  # App configuration\n'
              '  PACKAGE_NAME = "com.example.flutter_starter" # Set by the rename: fork-and-customize section 2, or the setup brick\n'
              '  APP_NAME = "Flutter Starter" # Set by the rename: fork-and-customize section 2, or the setup brick\n'
              '\n'
              '  # ========================================================================\n'
              '  # Helper Lanes\n'
              '  # ========================================================================\n'
              '\n'
              '  # Get version from pubspec.yaml\n'
              '  desc "Get version from pubspec.yaml"\n'
