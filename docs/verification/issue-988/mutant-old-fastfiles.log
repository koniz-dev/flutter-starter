  Expected: match 'require_relative '[./]*\S*ssl_pinning''
    Actual: '# Fastfile - iOS Deployment Automation\n'
              '# This file contains all the lanes (tasks) for iOS deployment\n'
              '# See: https://docs.fastlane.tools/actions/\n'
              '#\n'
              '# fastlane runs with the working directory set to THIS file\'s folder,\n'
              '# ios/fastlane/. So `..` is ios/ and the REPOSITORY ROOT is `../..`.\n'
              '# The root fastlane/Fastfile is one level shallower and uses `..` for the same\n'
              '# thing - the two files deliberately do not share a convention.\n'
              '\n'
              'require \'shellwords\'\n'
              '\n'
              '# Default platform\n'
              'default_platform(:ios)\n'
              '\n'
              'platform :ios do\n'
              '  # ========================================================================\n'
              '  # Configuration\n'
              '  # ========================================================================\n'
              '\n'
              '  # App configuration\n'
              '  APP_IDENTIFIER = "com.example.flutterStarter" # Set by the rename: fork-and-customize section 2, or the setup brick\n'
              '  APP_NAME = "Flutter Starter" # Set by the rename: fork-and-customize section 2, or the setup brick\n'
              '\n'
              '  # Repository root, relative to this Fastfile\'s working directory.\n'
              '  REPO_ROOT = "../.."\n'
              '\n'
              '  # ========================================================================\n'
              '  # Helper Lanes\n'
              '  # ========================================================================\n'
              '\n'
              '  # Get version from pubspec.yaml\n'
              '  desc "Get version from pubspec.yaml"\n'
              '  lane :get_version do\n'
              '    pubspec = File.read("#{REPO_ROOT}/pubspec.yaml")\n'
              '    version_match = pubspec.match(/version:\\s*([\\d.]+)\\+(\\d+)/)\n'
              '    UI.user_error!("Could not parse version from pubspec.yaml") unless version_match\n'
              '\n'
              '    version_name = version_match[1]\n'
              '    build_number = version_match[2]\n'
              '    UI.message("Version: #{version_name}, Build: #{build_number}")\n'
              '    # NOT `return`: a lane body is a block, and `return` inside one raises\n'
              '    # LocalJumpError, which fastlane reports as an error in the lane that\n'
              '    # *called* this one. The last expression is the lane\'s return value.\n'
              '    { version: version_name, build: build_number }\n'
              '  end\n'
              '\n'
              '  # ========================================================================\n'
              '  # Build Lanes\n'
              '  # ========================================================================\n'
              '\n'
              '  desc "Build IPA for App Store"\n'
              '  lane :build_appstore do |options|\n'
              '    environment = options[:environment] || "production"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_PRODUCTION"] || "https://api.example.com"\n'
              '\n'
              '    UI.message("Building for App Store - Environment: #{environment}")\n'
              '\n'
              '    # The bundled-secrets guard, before any build: a `.env` declared as a\n'
              '    # Flutter asset ships inside the artifact. `sh` raises on a non-zero exit,\n'
              '    # so a failing guard aborts the lane.\n'
              '    sh("cd #{REPO_ROOT} && dart run tool/check_env_assets.dart")\n'
              '\n'
              '    # Get version info\n'
              '    version_info = get_version\n'
              '\n'
              '    # Build IPA using Flutter. `--export-method app-store` is the default, but\n'
              '    # stating it keeps this lane readable next to build_adhoc.\n'
              '    sh("cd #{REPO_ROOT} && flutter build ipa " \\\n'
              '       "--release " \\\n'
              '       "--export-method app-store " \\\n'
              '       "--dart-define=ENVIRONMENT=#{Shellwords.escape(environment)} " \\\n'
              '       "--dart-define=BASE_URL=#{Shellwords.escape(base_url)}")\n'
              '\n'
              '    # IPA path\n'
              '    # Absolute: lane code runs in ios/fastlane/, but fastlane runs every\n'
              '    # action from ios/, so the relative path would name a file outside the\n'
              '    # repository by the time upload_to_testflight / upload_to_app_store read it.\n'
              '    ipa_path = File.expand_path("#{REPO_ROOT}/build/ios/ipa/Runner.ipa")\n'
              '\n'
              '    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)\n'
              '\n'
              '    UI.success("IPA built successfully: #{ipa_path}")\n'
              '    ipa_path\n'
              '  end\n'
              '\n'
              '  desc "Build IPA for Ad Hoc distribution"\n'
              '  lane :build_adhoc do |options|\n'
              '    environment = options[:environment] || "staging"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_STAGING"] || "https://api-staging.example.com"\n'
              '\n'
              '    UI.message("Building for Ad Hoc - Environment: #{environment}")\n'
              '\n'
              '    # The bundled-secrets guard, before any build: a `.env` declared as a\n'
              '    # Flutter asset ships inside the artifact. `sh` raises on a non-zero exit,\n'
              '    # so a failing guard aborts the lane.\n'
              '    sh("cd #{REPO_ROOT} && dart run tool/check_env_assets.dart")\n'
              '\n'
              '    # Without --export-method the export is app-store, which is NOT installable\n'
              '    # on the ad-hoc devices this lane exists to serve.\n'
              '    sh("cd #{REPO_ROOT} && flutter build ipa " \\\n'
              '       "--release " \\\n'
              '       "--export-method ad-hoc " \\\n'
              '       "--dart-define=ENVIRONMENT=#{Shellwords.escape(environment)} " \\\n'
              '       "--dart-define=BASE_URL=#{Shellwords.escape(base_url)}")\n'
              '\n'
              '    # Absolute: lane code runs in ios/fastlane/, but fastlane runs every\n'
              '    # action from ios/, so the relative path would name a file outside the\n'
              '    # repository by the time upload_to_testflight / upload_to_app_store read it.\n'
              '    ipa_path = File.expand_path("#{REPO_ROOT}/build/ios/ipa/Runner.ipa")\n'
              '\n'
              '    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)\n'
              '\n'
              '    UI.success("IPA built successfully: #{ipa_path}")\n'
              '    ipa_path\n'
              '  end\n'
              '\n'
              '  # ========================================================================\n'
              '  # Deployment Lanes\n'
              '  # ========================================================================\n'
              '\n'
              '  desc "Upload to App Store Connect"\n'
              '  lane :upload_appstore do |options|\n'
              '    environment = options[:environment] || "production"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_PRODUCTION"] || "https://api.example.com"\n'
              '    # `options[:x] || true` is always true - fetch with a default is the only way\n'
              '    # to let a caller pass false.\n'
              '    skip_screenshots = options.fetch(:skip_screenshots, true)\n'
              '    skip_metadata = options.fetch(:skip_metadata, true)\n'
              '\n'
              '    # Build IPA\n'
              '    ipa_path = build_appstore(environment: environment, base_url: base_url)\n'
              '\n'
              '    # Upload to App Store Connect\n'
              '    deliver(\n'
              '      ipa: ipa_path,\n'
              '      skip_screenshots: skip_screenshots,\n'
              '      skip_metadata: skip_metadata,\n'
              '      force: true,\n'
              '      submit_for_review: false, # Set to true to auto-submit for review\n'
              '      automatic_release: false, # Set to true for automatic release after approval\n'
              '      # API key: a fastlane key JSON file through APP_STORE_CONNECT_API_KEY_PATH\n'
              '      # (read automatically), or app_store_connect_api_key(...) before this call.\n'
              '      # api_key_path: ENV["APP_STORE_CONNECT_API_KEY_PATH"],\n'
              '    )\n'
              '\n'
              '    UI.success("Successfully uploaded to App Store Connect!")\n'
              '  end\n'
              '\n'
              '  desc "Upload to TestFlight"\n'
              '  lane :upload_testflight do |options|\n'
              '    environment = options[:environment] || "staging"\n'
              '    base_url = options[:base_url] || ENV["BASE_URL_STAGING"] || "https://api-staging.example.com"\n'
              '    groups = options[:groups] || ["Internal Testers"] # TestFlight groups\n'
              '\n'
              '    # Build IPA\n'
              '    ipa_path = build_appstore(environment: environment, base_url: base_url)\n'
              '\n'
              '    # Upload to TestFlight\n'
              '    pilot(\n'
